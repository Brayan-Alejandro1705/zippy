# Configuración de Base de Datos
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/toutain

# Configuración de API
API_TITLE=TOUTAIN API
API_VERSION=1.0.0
DEBUG=True

# JWT
SECRET_KEY=tu-clave-secreta-super-segura-aqui

# Servidor
HOST=0.0.0.0
PORT=8000

# Configuración de negocio
COMISION_TOUTAIN=5
IMPUESTO_IVA=19
COSTO_DOMICILIO_BASE=5000
COSTO_DOMICILIO_KM=1000

# Email (opcional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Correo que recibe el aviso cuando el servidor falla.
# Si se deja vacio, el aviso llega al remitente de Brevo.
EMAIL_ALERTAS=

# WhatsApp de bienvenida al vendedor (Cloud API de Meta).
# Sin TOKEN ni PHONE_ID no se manda nada y queda dicho en el registro.
# El TOKEN debe ser el permanente de un System User, no el de prueba de 24 h.
# El PHONE_ID son digitos que da Meta; NO es el numero de telefono.
# La plantilla debe existir y estar APROBADA en Meta antes de que esto sirva
# (ver el encabezado de backend/whatsapp.py con el cuerpo exacto).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_IDIOMA=es
WHATSAPP_PLANTILLA_BIENVENIDA=bienvenida_vendedor
